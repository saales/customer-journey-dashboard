DATABASE_URL=postgresql://percorso_app:replace-me@localhost:5432/percorso?sslmode=disable
APP_ORIGIN=http://localhost:5173
LOGIN_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
TRUSTED_PROXY_IPS=
LOGIN_ATTEMPT_RETENTION_DAYS=7
# Optional transactional email via Resend (required for password recovery and automatic invitations)
RESEND_API_KEY=
EMAIL_FROM=

# Capacità (opzionali). Richieste API per IP ogni 15 minuti: aumentare se molti utenti condividono l'IP aziendale (default 1200).
API_RATE_LIMIT_MAX=1200
# Connessioni massime del pool verso PostgreSQL (default 5; rispettare il limite del piano Neon/pooler).
DB_POOL_MAX=5
