# Runtime HTTP PostgreSQL: ruolo applicativo non proprietario e senza BYPASSRLS.
DATABASE_URL=postgresql://percorso_app:replace-me@localhost:5432/percorso?sslmode=disable
APP_ORIGIN=http://localhost:5173
LOGIN_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
PORT=3001

