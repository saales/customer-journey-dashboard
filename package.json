{
  "name": "customer-journey-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Piattaforma SaaS B2B per l'analisi del percorso cliente con PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm test --workspaces",
    "test:e2e": "playwright test",
    "start": "npm run start -w server",
    "db:check": "npm run db:check -w server",
    "db:inspect": "npm run db:inspect -w server",
    "db:migrate": "npm run db:migrate -w server --",
    "db:bootstrap": "npm run db:bootstrap -w server --",
    "db:cleanup-login-attempts": "npm run db:cleanup-login-attempts -w server",
    "db:verify-readonly": "npm run db:verify-readonly -w server --",
    "db:delete-tenant": "npm run db:delete-tenant -w server --"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "^9.0.0"
  },
  "overrides": {
    "jsdom": "^25.0.1",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
