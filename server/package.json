{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/postgres-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/postgres-server.js",
    "test": "vitest run",
    "db:check": "tsx src/check-postgres.ts",
    "db:inspect": "tsx src/inspect-postgres-schema.ts",
    "db:migrate": "tsx src/migrate-postgres.ts",
    "db:bootstrap": "tsx src/bootstrap-postgres.ts",
    "db:cleanup-login-attempts": "tsx src/cleanup-login-attempts.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
